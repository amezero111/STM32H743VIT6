# Keil MDK build artifacts. These contain absolute paths and should be rebuilt locally.
MDK-ARM/VIT6/*.o
MDK-ARM/VIT6/*.d
MDK-ARM/VIT6/*.crf
MDK-ARM/VIT6/*.axf
MDK-ARM/VIT6/*.hex
MDK-ARM/VIT6/*.htm
MDK-ARM/VIT6/*.map
MDK-ARM/VIT6/*.dep
MDK-ARM/VIT6/*.lib
MDK-ARM/VIT6/*.elf
MDK-ARM/VIT6/*.iex
MDK-ARM/VIT6/*.lnp
MDK-ARM/VIT6/*.sct
MDK-ARM/VIT6/*.Bak
MDK-ARM/VIT6/*.lst
MDK-ARM/*.lst

# Keil per-user GUI/debug state. These also often contain absolute local paths.
MDK-ARM/*.uvguix.*
MDK-ARM/*.guix.*
MDK-ARM/.vscode/

# Local IDE / assistant state.
.vscode/
.claude/

# Local build logs and temporary test files.
outputs/
*.log
test_nan.c
test_nan.exe
